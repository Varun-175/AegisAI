rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS (Zero-Trust Security & Ownership Validation)
    // =========================================================================

    // Verify request is authenticated with Firebase Auth
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Verify the caller is the owner of the user partition
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Disallow arbitrary global access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // USER-ISOLATED DATA HIERARCHY
    // Path: /users/{userId}/...
    // =========================================================================
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);

      // User Profile (/users/{userId}/profile/main)
      match /profile/{docId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasAll(['email', 'updatedAt'])
          && request.resource.data.email is string;
        allow delete: if isOwner(userId);
      }

      // User Preferences (/users/{userId}/preferences/main)
      match /preferences/{docId} {
        allow read, write: if isOwner(userId);
      }

      // Journals (/users/{userId}/journals/{journalId})
      match /journals/{journalId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 20000;
        allow update: if isOwner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.content is string;
        allow delete: if isOwner(userId);
      }

      // Conversations (/users/{userId}/conversations/{conversationId})
      match /conversations/{conversationId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.userId == userId;
        allow delete: if isOwner(userId);

        // Subcollection: Messages (/users/{userId}/conversations/{conversationId}/messages/{messageId})
        match /messages/{messageId} {
          allow read: if isOwner(userId);
          allow create: if isOwner(userId)
            && request.resource.data.role in ['user', 'model', 'system']
            && request.resource.data.content is string;
          allow update: if false; // Messages are immutable audit entries
          allow delete: if isOwner(userId);
        }
      }

      // Governed Memories (/users/{userId}/memories/{memoryId})
      match /memories/{memoryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.status in ['approved', 'candidate', 'revoked', 'expired']
          && request.resource.data.content is string
          && request.resource.data.purpose is string
          && request.resource.data.expirationPolicy in ['1_day', '7_days', '30_days', 'project', 'forever'];
        allow update: if isOwner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.status in ['approved', 'revoked', 'expired'];
        allow delete: if isOwner(userId);
      }

      // Memory Candidates (/users/{userId}/memoryCandidates/{candidateId})
      match /memoryCandidates/{candidateId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.content is string;
        allow update, delete: if isOwner(userId);
      }

      // Tamper-Evident Audit Events (/users/{userId}/auditEvents/{eventId})
      match /auditEvents/{eventId} {
        allow read: if isOwner(userId);
        // Only server runtime or owner can append audit logs; immutability enforced
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasAll(['action', 'category', 'timestamp'])
          && request.resource.data.action is string;
        allow update, delete: if false; // Audit logs are strictly immutable
      }
    }
  }
}
